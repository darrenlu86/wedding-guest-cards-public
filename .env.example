# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# 把這個檔案複製成 .env.local，並填入你自己的值。
#
#   cp .env.example .env.local
#
# ⚠️ 絕對不要把 .env.local 推到 GitHub。.gitignore 已經幫你忽略它。
# =============================================================================


# -----------------------------------------------------------------------------
# 部署網域（必填，影響 Email 連結 + OG meta）
# -----------------------------------------------------------------------------
# 寄出的 Email「開啟卡片」按鈕、OG 預覽圖 metadataBase 都會用這個 URL。
# 若不填，Email 寄送 API 會在執行時 throw，避免賓客收到指向佔位網域的死連結。
#
# 範例：
#   NEXT_PUBLIC_SITE_URL=https://wedding.example.tw
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# Gmail OAuth2（寄送婚禮卡片 Email 功能）
# -----------------------------------------------------------------------------
# 這四個值「必須使用你自己的 Google 帳號和 OAuth Client」，
# 否則：
#   (1) 你的賓客寄出的 Email 會出現「找不到設定」錯誤；
#   (2) 如果你不小心填別人的 credentials，Email 會用別人的 Gmail 寄出。
#
# 取得方式（5 分鐘）：
#   1. 到 Google Cloud Console 建立一個 OAuth Desktop App
#      → https://console.cloud.google.com/apis/credentials
#   2. 啟用 Gmail API
#   3. 把 Client ID 和 Client Secret 填到下方
#   4. 跑 `npx tsx scripts/get-gmail-token.ts`，依提示授權，
#      取得 Refresh Token 並填到 GMAIL_REFRESH_TOKEN
#   5. GMAIL_SENDER_EMAIL 填你授權的那個 Gmail 信箱
#
# 詳細步驟見 README.md → 「Email 寄送設定（Gmail OAuth）」
#
# 不需要寄 Email？這四個變數可以不填，Email 按鈕會顯示錯誤，
# 但下載卡片、查看卡片、信封動畫等功能不受影響。
# -----------------------------------------------------------------------------

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=


# -----------------------------------------------------------------------------
# Redis（選用：Rate Limiting 持久化）
# -----------------------------------------------------------------------------
# 不填的話會用記憶體 fallback（單機 OK，多實例會失效）。
# 如果你部署到 Vercel / Cloudflare 並且有多個 instance，建議接 Upstash Redis。
# -----------------------------------------------------------------------------

# REDIS_URL=redis://default:password@your-redis-host:6379
